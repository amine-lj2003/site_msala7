# Copy this file to .env and fill in real values. Never commit .env itself.

# From Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# Where your frontend is served from (no trailing slash).
# Must exactly match, including protocol and port.
FRONTEND_ORIGIN=http://localhost:5500

# Port the backend listens on
PORT=4000

# Set to "true" only when serving both frontend and backend over HTTPS in production
COOKIE_SECURE=false
